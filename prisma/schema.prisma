generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  contactEmail      String
  contactPhone      String?
  industry          String?
  size              String?
  status            String             @default("PENDING")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  members           OrganizationMember[]
  subscriptions     Subscription[]
  invitations       OrganizationInvite[]
  opportunities     Opportunity[]
  activities        Activity[]

  @@index([status])
  @@schema("public")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  authUserId     String
  role           String       @default("STAFF")
  jobTitle       String?
  status         String       @default("ACTIVE")
  joinedAt       DateTime     @default(now())
  lastActiveAt   DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, authUserId])
  @@index([authUserId])
  @@index([organizationId, role])
  @@schema("public")
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String       @default("STAFF")
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@schema("public")
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String
  plan                 String
  billingInterval      String
  amountMinor          Int
  currency             String       @default("NGN")
  status               String       @default("TRIALING")
  trialStartedAt       DateTime     @default(now())
  trialEndsAt          DateTime
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  provider             String?
  providerCustomerId   String?
  providerSubscriptionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([trialEndsAt])
  @@schema("public")
}

model Opportunity {
  id           String        @id @default(cuid())
  organizationId String?
  name         String
  company      String
  email        String
  stage        String        @default("NEW_LEAD")
  value        Decimal       @db.Decimal(12, 2)
  lastActivity DateTime      @default(now())
  ownerId      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([ownerId])
  @@index([organizationId, stage])
  @@schema("public")
}

model Activity {
  id             String        @id @default(cuid())
  organizationId String?
  opportunityId  String
  type           String
  note           String?
  occurredAt     DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([opportunityId, occurredAt])
  @@index([organizationId, occurredAt])
  @@schema("public")
}

model StaffPerformance {
  id             String   @id @default(cuid())
  organizationId String
  authUserId     String
  periodStart    DateTime
  periodEnd      DateTime
  leadsCreated   Int      @default(0)
  qualifiedLeads Int      @default(0)
  dealsWon      Int      @default(0)
  revenue       Decimal  @default(0) @db.Decimal(12, 2)
  activities    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organizationId, authUserId, periodStart, periodEnd])
  @@index([organizationId, periodEnd])
  @@schema("public")
}
