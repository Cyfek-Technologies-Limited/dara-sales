DATABASE_URL=
PAYSTACK_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_PROSPECTING_MODEL=gpt-4.1-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only outreach configuration. Never prefix these with NEXT_PUBLIC_.
SMARTLEAD_API_KEY=
# Platform-wide emergency stop. Each organization separately approves its message
# and activates its own campaign in Dara. No shared campaign or organization ID.
SMARTLEAD_AUTOMATION_ENABLED=true
# Use a separate random secret for the protected queue worker endpoint.
CRON_SECRET=

# Google mailbox OAuth (separate from ordinary Google sign-in).
GOOGLE_MAILBOX_CLIENT_ID=
GOOGLE_MAILBOX_CLIENT_SECRET=
GOOGLE_MAILBOX_REDIRECT_URI=http://localhost:3000/api/admin/email-outreach/google/callback
# Set true only after registering the same OAuth app credentials in Smartlead.
SMARTLEAD_GOOGLE_OAUTH_CONFIGURED=false
